{
    "actorSpecification": 1,
    "fields": {
        "type": "object",
        "properties": {
            "recordType": {
                "type": "string",
                "description": "Record type: 'product' or 'shop'"
            },
            "itemId": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "Numeric Taobao/Tmall item ID (null on failed search rows)"
            },
            "query": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "Search keyword or query on failed search rows"
            },
            "url": {
                "type": "string",
                "description": "Canonical item or shop URL"
            },
            "platform": {
                "type": "string",
                "enum": [
                    "taobao",
                    "tmall"
                ],
                "description": "Marketplace platform"
            },
            "title": {
                "type": "string",
                "description": "Original Chinese product title"
            },
            "titleEn": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "English translated product title"
            },
            "brand": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "Brand name"
            },
            "categoryPath": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "Category breadcrumb path"
            },
            "mainImage": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "Primary product image URL"
            },
            "images": {
                "type": "array",
                "items": {
                    "type": "string"
                },
                "description": "Gallery image URLs"
            },
            "descriptionImages": {
                "type": "array",
                "items": {
                    "type": "string"
                },
                "description": "Product description image URLs"
            },
            "videoUrl": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "Product video URL if present"
            },
            "attributes": {
                "type": "object",
                "description": "Product attributes in Chinese"
            },
            "attributesEn": {
                "type": "object",
                "description": "Product attributes translated to English"
            },
            "price": {
                "type": [
                    "number",
                    "null"
                ],
                "description": "Current active price in CNY"
            },
            "originalPrice": {
                "type": [
                    "number",
                    "null"
                ],
                "description": "Original crossed-out price in CNY"
            },
            "promoPrice": {
                "type": [
                    "number",
                    "null"
                ],
                "description": "Promotion price in CNY before coupons"
            },
            "finalPrice": {
                "type": [
                    "number",
                    "null"
                ],
                "description": "Computed final price in CNY after best coupon, shop discount, and threshold deal"
            },
            "finalPriceDiscounts": {
                "type": "array",
                "description": "Applied discount and coupon breakdown for finalPrice"
            },
            "unappliedDiscounts": {
                "type": "array",
                "items": {
                    "type": "string"
                },
                "description": "Unparsed or unapplied promotion labels when priceType is partial"
            },
            "priceType": {
                "type": "string",
                "description": "How the price was determined (exact_final, partial, promo_only, base_price, range_min, unknown)"
            },
            "currency": {
                "type": "string",
                "description": "Currency of price, originalPrice, promoPrice, finalPrice, minPrice, maxPrice and SKU prices. Always CNY."
            },
            "priceConverted": {
                "type": [
                    "number",
                    "null"
                ],
                "description": "Effective price (finalPrice, else promoPrice, else price) converted into convertedCurrency"
            },
            "convertedCurrency": {
                "type": "string",
                "description": "Currency of priceConverted / finalPriceConverted (the 'currency' input, e.g. USD)"
            },
            "finalPriceConverted": {
                "type": [
                    "number",
                    "null"
                ],
                "description": "finalPrice converted into convertedCurrency (null when no exact final price)"
            },
            "minPrice": {
                "type": [
                    "number",
                    "null"
                ],
                "description": "Lowest real price in CNY across listing price, price range and real SKU prices"
            },
            "maxPrice": {
                "type": [
                    "number",
                    "null"
                ],
                "description": "Highest real price in CNY across listing price, price range and real SKU prices"
            },
            "priceWarning": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "Set when a placeholder price such as 9999 or 99999 was rejected"
            },
            "detailSource": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "Where product detail came from: world_ssr, seo_pdp_api, mtop_detail, playwright, playwright_world, world_html, or null for listing-only rows"
            },
            "exchangeRate": {
                "type": [
                    "number",
                    "null"
                ],
                "description": "CNY to target currency exchange rate"
            },
            "exchangeRateDate": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "ISO date of the exchange rate"
            },
            "exchangeRateSource": {
                "type": "string",
                "enum": [
                    "live",
                    "fallback"
                ],
                "description": "Source of the exchange rate: 'live' or 'fallback'"
            },
            "translationStatus": {
                "type": "string",
                "enum": [
                    "ok",
                    "partial",
                    "failed",
                    "disabled"
                ],
                "description": "Status of Chinese-to-English translation"
            },
            "salesText": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "Raw sales string from Taobao/Tmall (e.g. '1万+')"
            },
            "salesCount": {
                "type": [
                    "number",
                    "null"
                ],
                "description": "Parsed lower-bound numeric sales count"
            },
            "stock": {
                "type": [
                    "number",
                    "null"
                ],
                "description": "Total available stock (capped display ~200 on signed-out pages)"
            },
            "skus": {
                "type": "array",
                "description": "SKU variants with props, propsEn, price, originalPrice, finalPrice, stock, and image"
            },
            "shipFrom": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "Shipping origin city/province"
            },
            "shippingFee": {
                "type": [
                    "number",
                    "null"
                ],
                "description": "Domestic shipping fee in CNY (null when conditional such as 满X包邮)"
            },
            "shippingNote": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "Conditional shipping note (e.g. 满88包邮)"
            },
            "shopId": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "Shop identifier"
            },
            "shopName": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "Shop display name"
            },
            "shopType": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "Shop tier/type (taobao, tmall, flagship, etc.)"
            },
            "shopUrl": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "Shop storefront URL"
            },
            "sellerScores": {
                "type": [
                    "object",
                    "null"
                ],
                "description": "DSR scores: description, service, logistics"
            },
            "creditLevel": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "Seller credit rating level"
            },
            "shopAgeYears": {
                "type": [
                    "number",
                    "null"
                ],
                "description": "Shop age in years"
            },
            "shopProductCount": {
                "type": [
                    "number",
                    "null"
                ],
                "description": "Total products in shop"
            },
            "agentLinks": {
                "type": "object",
                "description": "Shopping agent links (superbuy, cssbuy, sugargoo, cnfans, hoobuy)"
            },
            "dataCompleteness": {
                "type": "number",
                "description": "Completeness score from 0 to 100"
            },
            "missingFields": {
                "type": "array",
                "items": {
                    "type": "string"
                },
                "description": "List of fields missing on this record"
            },
            "status": {
                "type": "string",
                "enum": [
                    "ok",
                    "partial",
                    "failed"
                ],
                "description": "Extraction status"
            },
            "errorReason": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "Failure or partial warning explanation"
            },
            "scrapedAt": {
                "type": "string",
                "description": "ISO timestamp of scrape"
            },
            "changeType": {
                "type": [
                    "string",
                    "null"
                ],
                "enum": [
                    "new",
                    "changed",
                    "unchanged",
                    null
                ],
                "description": "Monitoring change status compared to previous run"
            },
            "previousValues": {
                "type": "object",
                "description": "Previous field values when changeType is 'changed'"
            }
        }
